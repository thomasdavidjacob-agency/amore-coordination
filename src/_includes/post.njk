---
layout: base.njk
article: true
ogType: article
---
{#- No dates anywhere on blog posts (Phuong, 2026-11-02). The publish date is internal only. -#}
{%- set cl = clusters[cluster] if cluster else null -%}
{%- set hub = collections.liveClusters | selectattr("key", "equalto", cluster) | first if cluster else null -%}

<article class="post">
  <header class="post__head">
    <p class="section__eyebrow">
      <a href="/blog/" class="back-link">Journal</a>{% if hub %} &nbsp;·&nbsp; <a href="/blog/topic/{{ cl.slug }}/" class="back-link">{{ cl.name }}</a>{% endif %}
    </p>
    <h1 class="post__title">{{ title }}</h1>
    <p class="post__meta">{{ author or site.founder }}</p>
  </header>

  <div class="post__body">
    {{ content | safe }}

    {% if faq and faq.length %}
    <section class="post__faq">
      <h2>Frequently Asked Questions</h2>
      {% for f in faq %}
      <h3>{{ f.q }}</h3>
      <p>{{ f.a }}</p>
      {% endfor %}
    </section>
    {% endif %}

    {% if pillar and hub and hub.posts.length > 1 %}
    <section class="post__series">
      <h2>More on {{ cl.name | lower }}</h2>
      <ul>
        {% for p in hub.posts %}{% if p.url != page.url %}
        <li><a href="{{ p.url }}">{{ p.data.title }}</a></li>
        {% endif %}{% endfor %}
      </ul>
    </section>
    {% endif %}
  </div>

  {% set related = collections.blog | relatedPosts(page, cluster, 3) %}
  {% if related.length %}
  <aside class="post__related" aria-label="Related reading">
    <p class="post__related-eyebrow">Related reading</p>
    <ul>
      {% for p in related %}
      <li><a href="{{ p.url }}">{{ p.data.title }}</a></li>
      {% endfor %}
    </ul>
  </aside>
  {% endif %}

  <div class="post__cta">
    <p class="post__cta-eyebrow">Thinking about your own day?</p>
    <p class="post__cta-text">If this sounds like the kind of support you've been hoping for, I'd love to hear your story.</p>
    <a href="/contact/" class="btn btn--dark">Start a Conversation</a>
    {% if cl and cl.service %}<p class="post__cta-more"><a href="{{ service or cl.service }}">See how I can help</a></p>{% endif %}
  </div>
</article>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ '/' | absUrl(site.url) }}" },
    { "@type": "ListItem", "position": 2, "name": "Journal", "item": "{{ '/blog/' | absUrl(site.url) }}" }
    {%- if hub %},
    { "@type": "ListItem", "position": 3, "name": {{ cl.name | dump | safe }}, "item": "{{ ('/blog/topic/' + cl.slug + '/') | absUrl(site.url) }}" },
    { "@type": "ListItem", "position": 4, "name": {{ title | dump | safe }}, "item": "{{ page.url | absUrl(site.url) }}" }
    {%- else %},
    { "@type": "ListItem", "position": 3, "name": {{ title | dump | safe }}, "item": "{{ page.url | absUrl(site.url) }}" }
    {%- endif %}
  ]
}
</script>
{% if faq and faq.length %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for f in faq %}
    { "@type": "Question", "name": {{ f.q | dump | safe }}, "acceptedAnswer": { "@type": "Answer", "text": {{ f.a | dump | safe }} } }{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]
}
</script>
{% endif %}
