---
layout: base.njk
title: Services & Pricing
description: "Wedding planning packages from Amore Coordination in Portland, OR — day-of coordination, partial planning, and full-service planning, with everything each package includes."
faqSchema: true
---

<section class="page-hero">
  <p class="section__eyebrow">Investment</p>
  <h1 class="page-hero__title">Services &amp; Pricing</h1>
  <p class="page-hero__sub">Transparent packages, thoughtfully designed around how much support you'd like.</p>
</section>

<section class="expect">
  <div class="section__head">
    <p class="section__eyebrow">What to Expect</p>
    <h2 class="section__title">How I work with you</h2>
  </div>
  <div class="expect__grid">
    {% for e in services.expect %}
    <article class="expect__item">
      <h3 class="expect__title">{{ e.title }}</h3>
      <p class="expect__tagline">{{ e.tagline }}</p>
      <p class="expect__text">{{ e.text }}</p>
    </article>
    {% endfor %}
  </div>
</section>

<section class="services">
  <div class="packages">
    {% for pkg in services.packages %}
    <article class="pkg{% if pkg.featured %} pkg--featured{% endif %}">
      {% if pkg.featured %}<span class="pkg__flag">Most Popular</span>{% endif %}
      <h2 class="pkg__name">{{ pkg.name }}</h2>
      <p class="pkg__price">{{ pkg.price }}</p>
      <p class="pkg__type">{{ pkg.type }}</p>
      <p class="pkg__desc">{{ pkg.desc }}</p>
      <div class="pkg__box">
        <p class="pkg__hours">{{ pkg.hours }}</p>
        <a href="#pkg-{{ pkg.slug }}" class="pkg__more">See everything included</a>
      </div>
      <a href="/contact/" class="btn btn--dark">Inquire</a>
    </article>
    {% endfor %}
  </div>

  <p class="services__note">{{ services.packageNote }}</p>
</section>

<section class="pkgdetails">
  <div class="section__head">
    <p class="section__eyebrow">In Detail</p>
    <h2 class="section__title">What each package includes</h2>
  </div>

  {% for pkg in services.packages %}
  <article class="pkgdetail" id="pkg-{{ pkg.slug }}">
    <header class="pkgdetail__head">
      <p class="pkgdetail__flag">{{ pkg.flag }}</p>
      <h3 class="pkgdetail__name">{{ pkg.name }}</h3>
      <p class="pkgdetail__meta">{{ pkg.type }} · {{ pkg.price }}</p>
    </header>

    <div class="acc" data-accordion>
      <div class="acc__item">
        <button class="acc__q" type="button">What is included with this package?</button>
        <div class="acc__a">
          <ul class="incl">
            {% for item in pkg.includes %}
            <li><strong>{{ item.title }}</strong> — {{ item.text }}</li>
            {% endfor %}
          </ul>
          <p class="incl__note">{{ services.packageNote }}</p>
        </div>
      </div>

      <div class="acc__item">
        <button class="acc__q" type="button">Who is the {{ pkg.name }} package for?</button>
        <div class="acc__a">
          {% for para in pkg.longDesc %}
          <p>{{ para }}</p>
          {% endfor %}
        </div>
      </div>
    </div>

    <a href="/contact/" class="btn btn--dark pkgdetail__cta">Inquire about {{ pkg.name }}</a>
  </article>
  {% endfor %}
</section>

<section class="addons">
  <div class="section__head">
    <p class="section__eyebrow">Add-Ons</p>
    <h2 class="section__title">Embellishments</h2>
  </div>

  <div class="acc" data-accordion>
    {% for a in services.addons %}
    <div class="acc__item">
      <button class="acc__q" type="button">
        <span class="acc__label">
          {{ a.name }}
          <em class="acc__tagline">{{ a.tagline }}</em>
        </span>
        <span class="acc__price">{{ a.price }}</span>
      </button>
      <div class="acc__a">
        {% for para in a.desc %}
        <p>{{ para }}</p>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>
</section>

<section class="faq" id="faq">
  <div class="section__head">
    <p class="section__eyebrow">Good to Know</p>
    <h2 class="section__title">Frequently Asked</h2>
  </div>
  <div class="faq__list acc" id="faqList" data-accordion>
    {% for f in faqs %}
    <div class="faq__item acc__item">
      <button class="faq__q acc__q" type="button">{{ f.q }}</button>
      <div class="faq__a acc__a"><p>{{ f.a }}</p></div>
    </div>
    {% endfor %}
  </div>
</section>

<section class="cta-band">
  <div class="cta-band__inner">
    <p class="section__eyebrow">Ready When You Are</p>
    <h2 class="section__title">Let's find your perfect fit.</h2>
    <p class="cta-band__lead">Not sure which package suits your day? Tell me a little about your plans and I'll guide you.</p>
    <a href="/contact/" class="btn btn--dark">Start Your Inquiry</a>
  </div>
</section>
